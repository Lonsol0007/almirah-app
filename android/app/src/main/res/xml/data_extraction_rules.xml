<?xml version="1.0" encoding="utf-8"?>
<!-- Case data is client information: keep it out of cloud backups and phone-to-phone transfers (Android 12+).
     Advocates move cases with the app's own Back up and restore screen. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
