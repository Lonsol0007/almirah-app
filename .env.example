# Copy to .env.local and fill in. Never commit real values.
# Leave the Supabase values empty to run the app as an on-device demo.

# --- public (shipped to the browser) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3100
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- server only ---
SUPABASE_SERVICE_ROLE_KEY=

# Stripe: use test-mode keys (sk_test_...) until you go live
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=

# Resend: a verified sending domain, e.g. "Almirah <reminders@yourdomain.in>"
RESEND_API_KEY=
EMAIL_FROM=

# Long random string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
